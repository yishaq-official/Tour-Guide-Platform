# ==============================================================================
# TravelAssist Docker Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.docker.example .env
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=production

# Database configuration (Internal Docker network hostname is 'mongodb')
MONGODB_URI=mongodb://mongodb:27017/travelAssist?replicaSet=rs0

# Better Auth Secret (Generate a strong random string in production)
BETTER_AUTH_SECRET=travel-assist-secure-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# AI & RAG configuration
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client Build Variables
VITE_API_URL=http://localhost:5000/api
VITE_AUTH_URL=http://localhost:5000
